<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>proscenio</vendor>
  <vendor_url>https://github.com/The1fEst/proscenio</vendor_url>
  <action id="dev.fEst.Proscenio.system">
    <description>Change system settings from proscenio</description>
    <message>Authentication is required to change system settings</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/proscenio</annotate>
  </action>
</policyconfig>
