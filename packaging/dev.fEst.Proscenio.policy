<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>proscenio</vendor>
  <vendor_url>https://github.com/The1fEst/proscenio</vendor_url>
  <action id="dev.fEst.Proscenio.system">
    <description>Change system settings from proscenio</description>
    <message>Authentication is required to change system settings</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/proscenio</annotate>
  </action>
  <action id="dev.fEst.Proscenio.packages">
    <description>Update the system from proscenio</description>
    <message>Authentication is required to update the system</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/proscenio/proscenio-packages</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">session</annotate>
  </action>
  <action id="dev.fEst.Proscenio.hyprpm">
    <description>Install or update the window title bars from proscenio</description>
    <message>Authentication is required to install or update the window title bars plugin</message>
    <message xml:lang="de">Zum Installieren oder Aktualisieren des Titelleisten-Plugins ist eine Authentifizierung erforderlich</message>
    <message xml:lang="es">Se requiere autenticación para instalar o actualizar el complemento de barras de título</message>
    <message xml:lang="fr">Une authentification est requise pour installer ou mettre à jour le module des barres de titre</message>
    <message xml:lang="he">נדרש אימות כדי להתקין או לעדכן את תוסף שורות הכותרת</message>
    <message xml:lang="id">Autentikasi diperlukan untuk memasang atau memperbarui plugin bilah judul</message>
    <message xml:lang="it">È richiesta l'autenticazione per installare o aggiornare il plugin delle barre del titolo</message>
    <message xml:lang="ja">タイトルバープラグインをインストールまたは更新するには認証が必要です</message>
    <message xml:lang="pt_BR">É necessária autenticação para instalar ou atualizar o plugin das barras de título</message>
    <message xml:lang="ru">Для установки или обновления плагина заголовков окон требуется аутентификация</message>
    <message xml:lang="tr">Başlık çubuğu eklentisini kurmak veya güncellemek için kimlik doğrulama gerekiyor</message>
    <message xml:lang="uk">Для встановлення або оновлення плагіна заголовків вікон потрібна автентифікація</message>
    <message xml:lang="vi">Cần xác thực để cài đặt hoặc cập nhật phần bổ trợ thanh tiêu đề</message>
    <message xml:lang="zh_CN">安装或更新标题栏插件需要身份验证</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/proscenio/proscenio-packages</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">hyprpm</annotate>
  </action>
</policyconfig>
